#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        ht_bck: ht_bck {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_BCK";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "balanced";
        };

        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        as: as {
            compatible = "zmk,behavior-hold-tap";
            label = "AS";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        lhmrow: lhmrow {
            compatible = "zmk,behavior-hold-tap";
            label = "LHMROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <30>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-key-positions = <7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 46 47 6 7 8 9 10 20 21 22 23 24 25 35 36 37 38 39 45 46 47 19>;
        };

        rhmrow: rhmrow {
            compatible = "zmk,behavior-hold-tap";
            label = "RHMROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <30>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 34 42 43 44>;
        };

        mk_capt: mk_capt {
            compatible = "zmk,behavior-tap-dance";
            label = "MK_CAPT";
            #binding-cells = <0>;
            bindings =
                <&ht LS(LC(LG(NUMBER_4))) LG(LS(NUMBER_2))>,
                <&ht LG(LS(N5)) LG(LS(NUMBER_4))>;

            tapping-term-ms = <185>;
        };

        it_e: it_e {
            compatible = "zmk,behavior-hold-tap";
            label = "IT_E";
            bindings = <&it_shift_egrav>, <&it_egrav>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        dt_ameth: dt_ameth {
            compatible = "zmk,behavior-tap-dance";
            label = "DT_AMETH";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp LA(LS(O))>, <&kp LA(LS(D))>, <&kp LS(LA(J))>;
        };

        cat_sh_hml: cat_sh_hml {
            compatible = "zmk,behavior-tap-dance";
            label = "CAT_SH_HML";
            #binding-cells = <0>;
            bindings = <&ht LEFT_SHIFT LS(LA(LG(SLASH)))>, <&to 0>;

            tapping-term-ms = <220>;
        };

        cat_nav_sh: cat_nav_sh {
            compatible = "zmk,behavior-tap-dance";
            label = "CAT_NAV_SH";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ht LEFT_SHIFT LS(LA(LG(SLASH)))>, <&to 6>;
        };

        raycast: raycast {
            compatible = "zmk,behavior-tap-dance";
            label = "RAYCAST";
            #binding-cells = <0>;
            bindings = <&lt 4 LG(SPACE)>, <&kp LC(LG(SPACE))>;

            tapping-term-ms = <200>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        it_egrav: it_egrav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp RG(E)>;
            label = "IT_EGRAV";
            wait-ms = <30>;
        };

        it_shift_egrav: it_shift_egrav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E) &kp E>;
            label = "IT_SHIFT_EGRAV";
        };

        it_i: it_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp I>;
            label = "IT_I";
        };

        it_o: it_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp O>;
            label = "IT_O";
        };

        it_u: it_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp U>;
            label = "IT_U";
        };

        it_a: it_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp A>;
            label = "IT_A";
        };

        elaugh: elaugh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp L &kp A>;
            label = "ELAUGH";
            wait-ms = <20>;
        };

        eok: eok {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp O &kp K>;
            label = "EOK";
            wait-ms = <20>;
        };

        ethank: ethank {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp T &kp H>;
            label = "ETHANK";
            wait-ms = <20>;
        };

        esmile: esmile {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp S &kp M>;
            label = "ESMILE";
            wait-ms = <20>;
        };

        esad: esad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp S &kp A &kp D>;
            label = "ESAD";
            wait-ms = <20>;
        };

        elove: elove {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp L &kp V>;
            label = "ELOVE";
            wait-ms = <20>;
        };

        ehmmm: ehmmm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp H &kp M>;
            label = "EHMMM";
            wait-ms = <20>;
        };

        ecoffe: ecoffe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp C &kp F>;
            label = "ECOFFE";
            wait-ms = <20>;
        };

        doublecmd: doublecmd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCMD &kp LCMD>;
            label = "DOUBLECMD";
            wait-ms = <50>;
        };

        doublectrl: doublectrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LCTRL>;
            label = "DOUBLECTRL";
            wait-ms = <50>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <3 2>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <1 0 2>;
        };

        Cut {
            bindings = <&kp LG(X)>;
            key-positions = <30 29>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <1 0 2>;
        };

        Copy {
            bindings = <&kp LG(C)>;
            key-positions = <30 31>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <1 0 2>;
        };

        Paste {
            bindings = <&kp LG(P)>;
            key-positions = <31 32>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        Del {
            bindings = <&kp DEL>;
            key-positions = <3 4>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        toLayerZezo {
            bindings = <&to 0>;
            key-positions = <28 29>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        cmd_shift_left {
            bindings = <&kp LG(LEFT_SHIFT)>;
            key-positions = <17 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        cmd_shift_right {
            bindings = <&kp RG(RIGHT_SHIFT)>;
            key-positions = <23 24>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        ctrl_cmd_left {
            bindings = <&kp LG(LCTRL)>;
            key-positions = <17 14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        cmd_ctrl_right {
            bindings = <&kp RG(RCTRL)>;
            key-positions = <23 26>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt_cmd_left {
            bindings = <&kp LG(LEFT_ALT)>;
            key-positions = <15 17>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt_cmd_right {
            bindings = <&kp RG(RIGHT_ALT)>;
            key-positions = <23 25>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt+shift-left {
            bindings = <&kp LA(LEFT_SHIFT)>;
            key-positions = <15 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt+shift-right {
            bindings = <&kp RA(RIGHT_SHIFT)>;
            key-positions = <25 24>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            display-name = "Colemak";
            bindings = <
&ht LS(TAB) TAB             &kp Q            &kp W               &kp F                 &kp P               &kp G                              &kp UP                &kp J        &kp L                &kp U                  &kp Y                    &kp SEMI            &kp BSLH
&ht_bck LA(BSPC) BACKSPACE  &lhmrow LCTRL A  &lhmrow LEFT_ALT R  &lhmrow LEFT_SHIFT S  &lhmrow LEFT_GUI T  &kp D                    &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &rhmrow RIGHT_GUI N  &rhmrow RIGHT_SHIFT E  &rhmrow RIGHT_ALT I      &rhmrow RCTRL O     &kp SQT
&cat_nav_sh                 &kp Z            &kp X               &kp C                 &kp V               &kp B           &none              &kp DOWN              &kp K        &kp M                &as LESS_THAN COMMA    &as GREATER_THAN PERIOD  &as QUESTION SLASH  &kp RSHFT
                                                                 &raycast              &lt 1 SPACE         &ht LCMD ENTER                                           &lt 6 ENTER  &lt 2 SPACE          &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Numbers {
            display-name = "Numbers";
            bindings = <
&trans    &kp EXCLAMATION              &kp AT_SIGN                    &kp POUND                      &kp DOLLAR                       &kp PERCENT                           &mmv MOVE_UP                        &kp LCTRL       &kp AMPERSAND         &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp CAPSLOCK
&trans    &lhmrow LCTRL NUMBER_1       &lhmrow LALT NUMBER_2          &lhmrow LEFT_SHIFT NUMBER_3    &lhmrow LGUI NUMBER_4            &kp N5                &mmv MOVE_LEFT  &kp LS(LA(LC(Z)))  &mmv MOVE_RIGHT  &kp N6          &rhmrow RGUI N7       &rhmrow RSHFT N8  &rhmrow RIGHT_ALT N9  &rhmrow RCTRL N0       &as PLUS EQUAL
&mk_capt  &as LEFT_BRACE LEFT_BRACKET  &as RIGHT_BRACE RIGHT_BRACKET  &ht LA(LC(LS(LEFT))) LC(LEFT)  &ht LA(LC(LS(RIGHT))) LC(RIGHT)  &dt_ameth    &none                    &mmv MOVE_DOWN                      &as PLUS EQUAL  &as UNDERSCORE MINUS  &trans            &trans                &trans                 &as GRAVE TILDE
                                                                      &kp LA(LS(B))                  &trans                           &trans                                                                    &trans          &trans                &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Move {
            display-name = "Move";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT                            &mmv MOVE_UP                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &bt BT_CLR    &mkp LCLK     &mkp MCLK  &mkp RCLK  &mkp MB4             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none      &none      &mkp MB5   &trans                    &mmv MOVE_DOWN                   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans     &trans     &kp SPACE                                                             &kp RET    &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Italian {
            display-name = "Italian";
            bindings = <
&studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                  &mmv MOVE_UP                     &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&trans          &trans      &mkp LCLK  &mkp MCLK    &mkp RCLK  &mkp MB4                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&trans          &sys_reset  &trans     &bootloader  &trans     &mkp MB5  &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                       &trans       &trans     &trans                                                                   &trans       &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Emoji {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            label = "Emoji";
        };

        BT_Sys {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            label = "BT_Sys";
        };

        Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            label = "Mouse";
        };
    };
};
