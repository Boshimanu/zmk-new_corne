#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <200>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&lt {
    tapping-term-ms = <175>;
    flavor = "balanced";
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        ht_bck: ht_bck {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_BCK";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "balanced";
        };

        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        as: as {
            compatible = "zmk,behavior-hold-tap";
            label = "AS";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <190>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        lhmrow: lhmrow {
            compatible = "zmk,behavior-hold-tap";
            label = "LHMROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <30>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-key-positions = <7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 46 47 6 7 8 9 10 20 21 22 23 24 25 35 36 37 38 39 45 46 47 19>;
        };

        rhmrow: rhmrow {
            compatible = "zmk,behavior-hold-tap";
            label = "RHMROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <30>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 34 42 43 44>;
        };

        mk_capt: mk_capt {
            compatible = "zmk,behavior-tap-dance";
            label = "MK_CAPT";
            #binding-cells = <0>;
            bindings =
                <&ht LS(LC(LG(NUMBER_4))) LG(LS(NUMBER_2))>,
                <&ht LG(LS(N5)) LG(LS(NUMBER_4))>;

            tapping-term-ms = <185>;
        };

        it_e: it_e {
            compatible = "zmk,behavior-hold-tap";
            label = "IT_E";
            bindings = <&it_shift_egrav>, <&it_egrav>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        dt_ameth: dt_ameth {
            compatible = "zmk,behavior-tap-dance";
            label = "DT_AMETH";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp LA(LS(O))>, <&kp LA(LS(D))>, <&kp LS(LA(J))>;
        };

        cat_sh_hml: cat_sh_hml {
            compatible = "zmk,behavior-tap-dance";
            label = "CAT_SH_HML";
            #binding-cells = <0>;
            bindings = <&ht LEFT_SHIFT LS(LA(LG(SLASH)))>, <&to 0>;

            tapping-term-ms = <220>;
        };

        cat_nav_sh: cat_nav_sh {
            compatible = "zmk,behavior-tap-dance";
            label = "CAT_NAV_SH";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ht LEFT_SHIFT LS(LA(LG(SLASH)))>, <&to 6>;
        };

        raycast: raycast {
            compatible = "zmk,behavior-tap-dance";
            label = "RAYCAST";
            #binding-cells = <0>;
            bindings = <&lt 4 LG(SPACE)>, <&kp LC(LG(SPACE))>;

            tapping-term-ms = <175>;
        };

        left_screen: left_screen {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFT_SCREEN";
            #binding-cells = <0>;
            tapping-term-ms = <175>;
            bindings = <&ht LA(LS(LC(W))) LC(LEFT)>, <&kp LA(LS(W))>;
        };

        right_screen: right_screen {
            compatible = "zmk,behavior-tap-dance";
            label = "RIGHT_SCREEN";
            #binding-cells = <0>;
            tapping-term-ms = <175>;
            bindings = <&ht LA(LS(LC(E))) LC(RIGHT)>, <&kp LA(LS(Y))>;
        };

        mic: mic {
            compatible = "zmk,behavior-tap-dance";
            label = "MIC";
            #binding-cells = <0>;
            bindings = <&kp F>, <&kp F>, <&kp RG(RS(G))>;

            tapping-term-ms = <180>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        it_egrav: it_egrav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp E>;
            label = "IT_EGRAV";
            wait-ms = <30>;
        };

        it_shift_egrav: it_shift_egrav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E) &kp E>;
            label = "IT_SHIFT_EGRAV";
        };

        it_i: it_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp I>;
            label = "IT_I";
        };

        it_o: it_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp O>;
            label = "IT_O";
        };

        it_u: it_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp U>;
            label = "IT_U";
        };

        it_a: it_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp A>;
            label = "IT_A";
        };

        elaugh: elaugh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp L &kp A>;
            label = "ELAUGH";
            wait-ms = <20>;
        };

        eok: eok {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp O &kp K>;
            label = "EOK";
            wait-ms = <20>;
        };

        ethank: ethank {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp T &kp H>;
            label = "ETHANK";
            wait-ms = <20>;
        };

        esmile: esmile {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp S &kp M>;
            label = "ESMILE";
            wait-ms = <20>;
        };

        esad: esad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp S &kp A &kp D>;
            label = "ESAD";
            wait-ms = <20>;
        };

        elove: elove {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp L &kp V>;
            label = "ELOVE";
            wait-ms = <20>;
        };

        ehmmm: ehmmm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp H &kp M>;
            label = "EHMMM";
            wait-ms = <20>;
        };

        ecoffe: ecoffe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp C &kp F>;
            label = "ECOFFE";
            wait-ms = <20>;
        };

        doublecmd: doublecmd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCMD &kp LCMD>;
            label = "DOUBLECMD";
            wait-ms = <50>;
        };

        doublectrl: doublectrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LCTRL>;
            label = "DOUBLECTRL";
            wait-ms = <100>;
        };

        efp: efp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE &kp F &kp P>;
            label = "EFP";
            wait-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <3 2>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <1 0 2>;
        };

        Cut {
            bindings = <&kp LG(X)>;
            key-positions = <30 29>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <1 0 2>;
        };

        Copy {
            bindings = <&kp LG(C)>;
            key-positions = <30 31>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <1 0 2>;
        };

        Paste {
            bindings = <&kp LG(V)>;
            key-positions = <31 32>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        Del {
            bindings = <&kp DEL>;
            key-positions = <3 4>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        toLayerZezo {
            bindings = <&kp LG(Z)>;
            key-positions = <28 29>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        cmd_shift_left {
            bindings = <&kp LG(LEFT_SHIFT)>;
            key-positions = <17 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        cmd_shift_right {
            bindings = <&kp RG(RIGHT_SHIFT)>;
            key-positions = <23 24>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        ctrl_cmd_left {
            bindings = <&kp LG(LCTRL)>;
            key-positions = <17 14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        cmd_ctrl_right {
            bindings = <&kp RG(RCTRL)>;
            key-positions = <23 26>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt_cmd_left {
            bindings = <&kp LG(LEFT_ALT)>;
            key-positions = <15 17>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt_cmd_right {
            bindings = <&kp RG(RIGHT_ALT)>;
            key-positions = <23 25>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt+shift-left {
            bindings = <&kp LA(LEFT_SHIFT)>;
            key-positions = <15 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt+shift-right {
            bindings = <&kp RA(RIGHT_SHIFT)>;
            key-positions = <25 24>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            display-name = "Colemak";
            bindings = <
&ht LS(TAB) TAB             &kp Q            &kp W               &kp F                 &kp P               &kp G                                        &kp C_VOLUME_UP                           &kp J        &kp L                &kp U                  &kp Y                    &kp SEMI            &kp BSLH
&ht_bck LA(BSPC) BACKSPACE  &lhmrow LCTRL A  &lhmrow LEFT_ALT R  &lhmrow LEFT_SHIFT S  &lhmrow LEFT_GUI T  &kp D                            &kp C_PREV  &as C_MUTE LS(LC(LG(LA(P))))  &kp C_NEXT  &kp H        &rhmrow RIGHT_GUI N  &rhmrow RIGHT_SHIFT E  &rhmrow RIGHT_ALT I      &rhmrow RCTRL O     &kp SQT
&cat_nav_sh                 &kp Z            &kp X               &kp C                 &kp V               &kp B           &kp LA(LS(O))                &kp C_VOL_DN                              &kp K        &kp M                &as LESS_THAN COMMA    &as GREATER_THAN PERIOD  &as QUESTION SLASH  &kp RSHFT
                                                                 &raycast              &lt 1 SPACE         &ht LCMD ENTER                                                                         &lt 6 ENTER  &lt 2 SPACE          &mo 3
            >;

            sensor-bindings = <&inc_dec_kp LS(LA(E)) LA(LS(N))>;
        };

        Numbers {
            display-name = "Numbers";
            bindings = <
&trans    &kp EXCLAMATION              &kp AT_SIGN                    &kp POUND                    &kp DOLLAR             &kp PERCENT                                      &kp LA(LS(S))                       &kp LCTRL       &kp AMPERSAND         &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp CAPSLOCK
&trans    &lhmrow LCTRL NUMBER_1       &lhmrow LALT NUMBER_2          &lhmrow LEFT_SHIFT NUMBER_3  &lhmrow LGUI NUMBER_4  &kp N5                            &kp LA(LS(J))  &kp LS(LA(B))  &kp LS(LG(LC(SQT)))  &kp N6          &rhmrow RGUI N7       &rhmrow RSHFT N8  &rhmrow RIGHT_ALT N9  &rhmrow RCTRL N0       &as PLUS EQUAL
&mk_capt  &as LEFT_BRACE LEFT_BRACKET  &as RIGHT_BRACE RIGHT_BRACKET  &left_screen                 &right_screen          &dt_ameth    &kp LS(LA(LC(Z)))                   &kp LS(LA(D))                       &as PLUS EQUAL  &as UNDERSCORE MINUS  &trans            &trans                &trans                 &as GRAVE TILDE
                                                                      &kp LA(LS(B))                &trans                 &trans                                                                               &trans          &trans                &trans
            >;

            sensor-bindings = <&inc_dec_kp LS(LA(LC(J))) LS(LA(LC(K)))>;
        };

        Move {
            display-name = "Move";
            bindings = <
&trans       &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &rgb_ug RGB_TOG                                       &mmv MOVE_UP                     &kp DEL           &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &trans    &kp PG_UP
&trans       &kp LCTRL        &kp LALT         &kp LSHFT        &kp LGUI         &kp ENTER                             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LG(UP_ARROW)  &kp LEFT      &kp DOWN  &kp RIGHT      &kp INS   &kp PG_DN
&cat_nav_sh  &rgb_ug RGB_EFR  &rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &kp SPACE        &kp LA(LS(LC(Z)))                    &mmv MOVE_DOWN                   &kp LG(DOWN)      &kp LG(LEFT)  &trans    &kp LG(RIGHT)  &kp HOME  &kp END
                                               &trans           &trans           &trans                                                                                 &trans            &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp LS(LA(U)) LS(LA(L))>;
        };

        Italian {
            display-name = "Italian";
            bindings = <
&kp C_PREV  &kp C_PP    &kp C_NEXT             &kp K_MUTE             &kp C_VOL_DN          &kp C_VOL_UP                                        &mmv MOVE_UP                     &trans      &trans      &it_u       &trans      &trans      &to 7
&trans      &it_a       &kp LS(LA(LC(LG(R))))  &kp LA(LS(LC(LG(F))))  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans      &trans      &it_e 0 0   &it_i       &it_o       &trans
&trans      &kp LG(N1)  &kp LG(N2)             &kp LG(N3)             &kp LG(N4)            &kp LG(N5)            &kp C_MUTE                    &mmv MOVE_DOWN                   &kp LG(N6)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &kp PAUSE_BREAK
                                               &trans                 &trans                &kp LS(LA(LC(D)))                                                                    &trans      &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp LS(LA(SPACE)) LS(LA(LC(SPACE)))>;
        };

        Emoji {
            bindings = <
&trans  &trans   &elove   &efp           &ehmmm         &trans                            &mmv MOVE_UP                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &elaugh  &esmile  &eok           &ethank        &esad             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &kp RG(RS(G))  &kp RS(RG(G))  &trans  &trans                    &mmv MOVE_DOWN                   &trans  &trans  &trans  &trans  &trans  &trans
                          &trans         &trans         &trans                                                             &trans  &trans  &trans
            >;

            label = "Emoji";
            sensor-bindings = <&inc_dec_kp LS(LA(PERIOD)) LA(LS(COMMA))>;
        };

        BT_Sys {
            bindings = <
&kp F1       &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                          &trans          &kp F7        &kp F8    &kp F9     &kp F10   &kp F11     &kp F12
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &out OUT_USB  &kp LGUI  &kp LSHFT  &kp LALT  &kp LCTRL   &out OUT_BLE
&bootloader  &sys_reset    &trans        &trans        &trans        &trans        &trans            &trans          &trans        &trans    &trans     &trans    &sys_reset  &bootloader
                                         &trans        &trans        &trans                                          &trans        &trans    &trans
            >;

            label = "BT_Sys";
        };

        Mouse {
            bindings = <
&trans       &trans  &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &trans                         &kp UP               &trans  &trans    &kp UP    &trans     &trans  &trans
&trans       &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans               &kp LEFT  &kp RET   &kp RIGHT  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&cat_sh_hml  &trans  &msc SCRL_LEFT  &trans          &msc SCRL_RIGHT  &trans     &trans              &kp DOWN             &trans  &trans    &trans    &trans     &trans  &trans
                                     &mkp MCLK       &mkp LCLK        &mkp RCLK                                           &trans  &trans    &trans
            >;

            label = "Mouse";
        };

        qwerty {
            bindings = <
&kp TAB    &kp Q     &kp W  &kp E      &kp R     &kp T                         &kp UP               &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSLH
&kp BSPC   &kp A     &kp S  &kp T      &kp F     &kp G               &kp LEFT  &kp RET   &kp RIGHT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp FSLH  &kp X  &kp C      &kp V     &kp B      &to 0              &kp DOWN             &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                            &kp LCTRL  &kp LALT  &kp SPACE                                          &kp ENTER  &mo 1  &kp ESC
            >;

            label = "qwerty";
            sensor-bindings = <&scroll_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        BT-Sys {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };
};
